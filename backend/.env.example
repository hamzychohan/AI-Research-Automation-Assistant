# Core Settings
PROJECT_NAME="AI Research & Automation Assistant"
SECRET_KEY="generate-a-secure-random-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=11520 # 8 days

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_assistant
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_assistant

# Redis Memory/Cache Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# LLM API Configs
OPENAI_API_KEY=your-openai-api-key-here

# Search Tool Configs
TAVILY_API_KEY=your-tavily-api-key-here

# Slack Automation Configs
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_CHANNEL=#general

# Gmail OAuth API Configs
GMAIL_CLIENT_ID=your-google-oauth-client-id
GMAIL_CLIENT_SECRET=your-google-oauth-client-secret
GMAIL_REFRESH_TOKEN=your-google-oauth-refresh-token
